@using QHPFH_ConceptPrototype.Services.Navigation
@implements IDisposable

<nav class="primary-nav" aria-label="Primary">
    <div class="primary-nav-track" role="menubar">
        @if (IsCompact)
        {
            <button type="button"
                    class="nav-link selected compact-active"
                    aria-expanded="@_isCollapsedMenuOpen"
                    @onclick="ToggleCollapsedMenu">
                <span>@GetActivePrimaryLabel()</span>
                <MudIcon Icon="@(_isCollapsedMenuOpen ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" Size="Size.Small" Class="nav-caret" />
            </button>
        }
        else
        {
            <button type="button" class="home-link @GetSelectedClass("home")" aria-label="Home" @onclick='() => SelectPrimary("home")'>
                <img src="images/header/home_icon.svg" alt="Home" class="home-icon" />
            </button>

            @foreach (var item in PrimaryItems)
            {
                var isActive = item.Key == _activePrimaryKey;
                <button type="button" class="nav-link nav-link-@item.Key @(isActive ? "selected" : null)" @onclick="() => SelectPrimary(item.Key)">
                    <span>@item.Label</span>
                    @if (item.HasSubMenu)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" Class="nav-caret" />
                    }
                </button>
            }
        }

        <button type="button"
                class="concept-nav-inline-toggle"
                aria-label="@(IsCompact ? "Expand workspace navigation" : "Collapse workspace navigation")"
                @onclick="OnToggleCompact">
            <MudIcon Icon="@(IsCompact ? Icons.Material.Outlined.LastPage : Icons.Material.Outlined.FirstPage)" Size="Size.Small" />
        </button>
    </div>

    @if (IsCompact && _isCollapsedMenuOpen)
    {
        <div class="collapsed-nav-menu" role="menu" aria-label="Collapsed navigation options">
            <button type="button" class="collapsed-nav-item @GetSelectedClass("home")" @onclick='() => SelectPrimaryFromCollapsed("home")'>Home</button>
            @foreach (var item in PrimaryItems)
            {
                <button type="button" class="collapsed-nav-item @(item.Key == _activePrimaryKey ? "selected" : null)" @onclick="() => SelectPrimaryFromCollapsed(item.Key)">@item.Label</button>
                @if (item.Key == _activePrimaryKey && item.SubItems.Count > 0)
                {
                    <div class="collapsed-sub-nav" role="group" aria-label="@item.Label secondary navigation">
                        @foreach (var subItem in item.SubItems)
                        {
                            <button type="button" class="collapsed-sub-nav-item @(subItem == _activeSubItem ? "selected" : null)" @onclick="() => SelectSubItemFromCollapsed(subItem)">@subItem</button>
                        }
                    </div>
                }
            }
        </div>
    }

    @if (!IsCompact && CurrentSubItems.Count > 0)
    {
        <div class="sub-nav-track" role="menubar" aria-label="Secondary">
            @foreach (var subItem in CurrentSubItems)
            {
                var isSubActive = subItem == _activeSubItem;
                <button type="button" class="sub-nav-link @(isSubActive ? "selected" : null)" @onclick="() => SelectSubItem(subItem)"><span>@subItem</span></button>
            }
        </div>
    }
</nav>

@code {
    [Inject] private NavigationStateService NavigationStateService { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private readonly List<PrimaryNavItem> PrimaryItems =
    [
        new("myhub", "MyHub", false, []),
        new("hospital", "Hospital Overview", false, []),
        new("dd", "Delayed Discharge", true, ["DD Hub", "Patient Management", "Census Management", "DDP Census"]),
        new("bed", "Bed & Ward", true, ["Bed and Ward Hub", "Bed Management", "Ward View", "Allocation Centre"]),
        new("scenario", "Scenario Mapping", false, []),
        new("journey", "Patient Journey", false, []),
        new("apps", "Connected Apps", false, [])
    ];

    private string _activePrimaryKey = "home";
    private string _activeSubItem = string.Empty;
    private bool _isCollapsedMenuOpen;

    private IReadOnlyList<string> CurrentSubItems => GetSubItemsForKey(_activePrimaryKey);

    [Parameter] public bool IsDarkMode { get; set; }
    [Parameter] public bool IsCompact { get; set; }
    [Parameter] public EventCallback OnToggleCompact { get; set; }

    private void SelectPrimary(string key)
    {
        var subItem = GetSubItemsForKey(key).FirstOrDefault() ?? string.Empty;
        NavigateForSelection(key, subItem, collapseAfterSelection: false);
    }

    private void SelectSubItem(string subItem)
    {
        NavigateForSelection(_activePrimaryKey, subItem, collapseAfterSelection: false);
    }

    private void SelectPrimaryFromCollapsed(string key)
    {
        var subItem = GetSubItemsForKey(key).FirstOrDefault() ?? string.Empty;
        NavigateForSelection(key, subItem, collapseAfterSelection: true);
    }

    private void SelectSubItemFromCollapsed(string subItem)
    {
        NavigateForSelection(_activePrimaryKey, subItem, collapseAfterSelection: true);
    }

    private void ToggleCollapsedMenu() => _isCollapsedMenuOpen = !_isCollapsedMenuOpen;

    private string GetSelectedClass(string key) => key == _activePrimaryKey ? "selected" : string.Empty;

    private string GetActivePrimaryLabel() =>
        PrimaryItems.FirstOrDefault(x => x.Key == _activePrimaryKey)?.Label ?? "Home";

    protected override void OnInitialized()
    {
        NavigationStateService.OnNavigationStateChanged += HandleNavigationStateChanged;
        SyncSelectionFromNavigationState();
    }

    private IReadOnlyList<string> GetSubItemsForKey(string key) =>
        PrimaryItems.FirstOrDefault(x => x.Key == key)?.SubItems ?? [];

    private void SyncSelectionFromNavigationState()
    {
        var snapshot = NavigationStateService.GetNavigationState();
        _activePrimaryKey = string.IsNullOrWhiteSpace(snapshot.CurrentPrimaryNavId) ? "home" : snapshot.CurrentPrimaryNavId;
        _activeSubItem = snapshot.CurrentSecondaryNavId;
    }

    private void HandleNavigationStateChanged()
    {
        SyncSelectionFromNavigationState();
        InvokeAsync(StateHasChanged);
    }

    private void NavigateForSelection(string primaryKey, string subItem, bool collapseAfterSelection)
    {
        var route = NavigationStateService.ResolveRoute(primaryKey, subItem);
        if (route is null)
        {
            _activePrimaryKey = primaryKey;
            _activeSubItem = subItem;
            NavigationStateService.SetPrimaryNav(_activePrimaryKey);
            NavigationStateService.SetSecondaryNav(_activeSubItem);
            return;
        }

        _activePrimaryKey = primaryKey;
        _activeSubItem = subItem;
        NavigationStateService.SetCurrentRoute(route);
        NavigationStateService.SetPrimaryNav(_activePrimaryKey);
        NavigationStateService.SetSecondaryNav(_activeSubItem);

        if (collapseAfterSelection)
        {
            _isCollapsedMenuOpen = false;
        }

        Nav.NavigateTo(route);
    }

    public void Dispose()
    {
        NavigationStateService.OnNavigationStateChanged -= HandleNavigationStateChanged;
    }

    private sealed record PrimaryNavItem(string Key, string Label, bool HasSubMenu, List<string> SubItems);
}
