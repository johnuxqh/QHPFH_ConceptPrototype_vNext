@using QHPFH_ConceptPrototype.Models.Filters

<section class="@AdditionalClasses" aria-label="Universal operational filters">
    <div class="@GroupClass">
        @if (Context.CanSelectHhs)
        {
            <FilterDropdown Label="HHS"
                            Value="@Context.Selection.SelectedHhs"
                            Options="@Context.HhsOptions"
                            ValueChanged="OnHhsChanged"
                            Searchable="@Searchable" />
        }
        @if (Context.CanSelectFacility)
        {
            <FilterDropdown Label="Facility"
                            Value="@Context.Selection.SelectedFacility"
                            Options="@Context.FacilityOptions"
                            ValueChanged="OnFacilityChanged"
                            Searchable="@Searchable" />
        }
        @if (Context.CanSelectWard)
        {
            <FilterDropdown Label="Ward"
                            Value="@Context.Selection.SelectedWard"
                            Options="@Context.WardOptions"
                            ValueChanged="OnWardChanged"
                            Searchable="@Searchable" />
        }
        @if (Context.CanSelectServiceStream)
        {
            <FilterDropdown Label="Service Stream"
                            Value="@Context.Selection.SelectedServiceStream"
                            Options="@Context.ServiceStreamOptions"
                            ValueChanged="OnServiceStreamChanged"
                            Searchable="@Searchable" />
        }
    </div>

    @ChildContent
</section>

@code {
    [Parameter, EditorRequired] public FilterContextRecord Context { get; set; } = default!;
    [Parameter] public EventCallback<FilterSelectionState> SelectionChanged { get; set; }
    [Parameter] public bool Searchable { get; set; }
    [Parameter] public string AdditionalClasses { get; set; } = "bm-filter-row";
    [Parameter] public string GroupClass { get; set; } = "bm-filter-group";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task OnHhsChanged(string value) => SelectionChanged.InvokeAsync(Context.Selection with
    {
        SelectedHhs = value,
        SelectedFacility = Context.AllFacilitiesLabel,
        SelectedWard = Context.AllWardsLabel
    });

    private Task OnFacilityChanged(string value) => SelectionChanged.InvokeAsync(Context.Selection with
    {
        SelectedFacility = value,
        SelectedWard = Context.AllWardsLabel
    });

    private Task OnWardChanged(string value) => SelectionChanged.InvokeAsync(Context.Selection with { SelectedWard = value });

    private Task OnServiceStreamChanged(string value) => SelectionChanged.InvokeAsync(Context.Selection with { SelectedServiceStream = value });
}
