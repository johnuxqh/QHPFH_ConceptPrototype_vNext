@page "/ward-operations"
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using QHPFH_ConceptPrototype.Components.Shared
@inject NavigationManager Navigation

<section class="page-shell-card bed-mgmt-page ward-ops ward-view-page" @onclick="CloseKpiInfo">
    <header class="ward-view-header">
        <div>
            <p class="ward-view-eyebrow">Ward operational workspace</p>
            <h2>Ward View · Ward 10A General Surgery</h2>
            <p>Bed status, incoming demand, clinical visibility and handover readiness for the ward team.</p>
        </div>
        <div class="ward-view-actions" aria-label="Ward support actions">
            <button type="button" class="bm-ghost">Generate handover</button>
            <button type="button" class="bm-ghost" @onclick='() => Navigation.NavigateTo("allocation-centre")'>View allocation queue</button>
            <button type="button" class="bm-ghost">Request bed clean</button>
            <button type="button" class="bm-ghost">Print downtime report</button>
            <button type="button" class="bm-ghost">Contact bed manager</button>
        </div>
    </header>

    @if (WardVersion == "V1")
    {
        <section class="bm-capacity-banner red ward-operational-banner">
            <strong>Tier 2 ward escalation · PAH Ward 10A</strong>
            <span>High demand across ED and inpatient flow. Prioritise confirmed discharges before 11:00, protect isolation capacity and escalate blocked beds to the NUM.</span>
        </section>

        <section class="bm-overview-cards ward-summary-strip ward-capacity-tiles" aria-label="Ward capacity">
            <SituationalKpiTile Title="Physical beds" Value="24" Subtitle="Configured bed spaces in this ward." IconName="open-bed-default" ColorClass="kpi-blue" InfoText="Physical beds are fixed bed spaces. They may be open, occupied or unavailable for operational reasons." IsInfoOpen='@(OpenWardKpiInfo == "Physical beds")' OnInfoClick='() => ToggleWardKpiInfo("Physical beds")' AdditionalClasses="ward-kpi-card" />
            <SituationalKpiTile Title="Open beds" Value="16" Subtitle="Open for operational use today." IconName="open-bed-green" ColorClass="kpi-green" InfoText="Open beds are physical beds available for ward operations today." IsInfoOpen='@(OpenWardKpiInfo == "Open beds")' OnInfoClick='() => ToggleWardKpiInfo("Open beds")' AdditionalClasses="ward-kpi-card" />
            <SituationalKpiTile Title="Occupied beds" Value="14" Subtitle="Actual inpatients on the ward." IconName="occupied-bed-default" ColorClass="kpi-gray" InfoText="Occupied beds currently have an admitted inpatient physically on the ward." IsInfoOpen='@(OpenWardKpiInfo == "Occupied beds")' OnInfoClick='() => ToggleWardKpiInfo("Occupied beds")' AdditionalClasses="ward-kpi-card" />
            <SituationalKpiTile Title="Pending beds" Value="8" Subtitle="Cleaning, maintenance, closure or planned use." IconName="cleaning-default" ColorClass="kpi-orange" TileType="breakdown" BreakdownItems="@WardPendingBreakdown" InfoText="Pending beds need an operational action before they are ready for the next patient." IsInfoOpen='@(OpenWardKpiInfo == "Pending beds")' OnInfoClick='() => ToggleWardKpiInfo("Pending beds")' AdditionalClasses="ward-kpi-card" />
            <SituationalKpiTile Title="Isolation / specialist" Value="2" Subtitle="Specialist capability in use or protected." IconName="isolation-bed-default" ColorClass="kpi-blue" InfoText="Beds with isolation, telemetry or specialist capability that require active ward coordination." IsInfoOpen='@(OpenWardKpiInfo == "Isolation / specialist")' OnInfoClick='() => ToggleWardKpiInfo("Isolation / specialist")' AdditionalClasses="ward-kpi-card" />
            <SituationalKpiTile Title="Expected admissions" Value="7" Subtitle="ED, elective, IHT, add-on and transfers." IconName="admission-default" ColorClass="kpi-orange" InfoText="Expected arrivals known to the ward but not all physically present yet." IsInfoOpen='@(OpenWardKpiInfo == "Expected admissions")' OnInfoClick='() => ToggleWardKpiInfo("Expected admissions")' AdditionalClasses="ward-kpi-card" />
        </section>

        <section class="ward-release-grid">
            <section class="ward-bed-board" aria-label="Bed status board">
                <div class="ward-section-heading">
                    <div>
                        <p>Bed status</p>
                        <h3>Bed board</h3>
                    </div>
                    <span>Physical beds remain fixed; open status changes through the shift.</span>
                </div>

                <div class="ward-bed-board-grid">
                    @foreach (var bed in BedRows.Take(12))
                    {
                        <article class="ward-bed-card state-@bed.StatusClass">
                            <div class="ward-bed-card__top">
                                <strong>@bed.BedLabel</strong>
                                <span>@bed.BedType</span>
                            </div>
                            <div class="bm-status-pill">
                                <MudIcon Icon="@StatusIcon(bed.Status)" Size="Size.Small" />
                                @bed.Status
                            </div>
                            <p>@bed.PatientStateLabel</p>
                            @if (bed.HasPatient)
                            {
                                <small>@bed.PatientName</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(bed.FutureAllocation))
                            {
                                <em>@bed.FutureAllocation</em>
                            }
                        </article>
                    }
                </div>
            </section>

            <aside class="ward-demand-panel" aria-label="Incoming and allocation pressure">
                <div class="ward-section-heading compact">
                    <div>
                        <p>Allocation pressure</p>
                        <h3>Incoming demand</h3>
                    </div>
                </div>
                <div class="ward-demand-list">
                    @foreach (var item in IncomingPressure)
                    {
                        <div class="ward-demand-item">
                            <span>@item.Source</span>
                            <strong>@item.Count</strong>
                            <small>@item.Note</small>
                        </div>
                    }
                </div>
            </aside>
        </section>

        <section class="bm-ward-table-wrap ward-clinical-grid" aria-label="Patient clinical visibility">
            <div class="ward-section-heading table-heading">
                <div>
                    <p>Clinical visibility</p>
                    <h3>Patient grid</h3>
                </div>
                <span>Actual inpatients and planned/virtual patients allocated to this ward.</span>
            </div>
            <table class="bm-ward-table">
                <thead>
                    <tr>
                        <th>Patient banner</th>
                        <th>Bed status</th>
                        <th>Team / specialty</th>
                        <th>EDD</th>
                        <th>LOS</th>
                        <th>Alerts / EWS</th>
                        <th>Waiting for what</th>
                        <th>Placement status</th>
                        <th>Diet / referrals</th>
                        <th class="actions-col">Handover</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bed in BedRows.Where(b => b.HasPatient || !string.IsNullOrWhiteSpace(b.FutureAllocation)).Take(12))
                    {
                        <tr class="state-@bed.StatusClass">
                            <td>
                                <div class="patient-banner @(bed.HasPatient ? "actual" : "planned")">
                                    <strong>@(bed.HasPatient ? bed.PatientName : "Planned admission")</strong>
                                    <small>@(bed.HasPatient ? bed.Demographics : bed.FutureAllocation)</small>
                                </div>
                            </td>
                            <td>
                                <strong>@bed.BedLabel</strong>
                                <div class="bm-status-pill">
                                    <MudIcon Icon="@StatusIcon(bed.Status)" Size="Size.Small" />
                                    @bed.Status
                                </div>
                            </td>
                            <td>@bed.Team</td>
                            <td>@bed.Edd</td>
                            <td>@bed.LosDays d</td>
                            <td>@bed.Allergies · EWS @bed.Ews</td>
                            <td>@bed.WaitingFor</td>
                            <td>@bed.PlacementStatus</td>
                            <td>@bed.Diet · @bed.Referral</td>
                            <td>
                                <div class="bm-inline-actions compact-actions">
                                    <button type="button" title="View patient">
                                        <MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" />
                                    </button>
                                    <button type="button" title="Handover note">
                                        <MudIcon Icon="@Icons.Material.Outlined.StickyNote2" Size="Size.Small" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <footer>Showing ward-level clinical visibility for current and planned patients</footer>
        </section>
    }
    else
    {
        <section class="bm-capacity-banner red">
            <strong>HOSPITAL CAPACITY STATUS: RED</strong>
            <span>Interactive ward workflow: drag incoming cards to ready beds, and drag beds to quick actions.</span>
        </section>

        <div class="bm-main-grid">
            <section class="bm-list-panel">
                <section class="bm-ward-table-wrap">
                    <table class="bm-ward-table">
                        <thead>
                            <tr>
                                <th>Bed</th>
                                <th>Status</th>
                                <th>Patient</th>
                                <th>Team</th>
                                <th>EDD</th>
                                <th>Waiting For</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var bed in V2BedRows.Take(10))
                            {
                                <tr class="state-@bed.StatusClass"
                                    draggable="true"
                                    @ondragstart="() => StartDragBedForAction(bed)"
                                    @ondragover="AllowDrop"
                                    @ondragover:preventDefault="true"
                                    @ondrop="() => DropPatientToBed(bed)">
                                    <td><strong>@bed.BedLabel</strong></td>

                                    <td>
                                        <div class="bm-status-pill">
                                            <MudIcon Icon="@StatusIcon(bed.Status)" Size="Size.Small" />
                                            @bed.Status
                                        </div>
                                    </td>

                                    <td>@(bed.HasPatient ? bed.PatientName : "—")</td>
                                    <td>@bed.Team</td>
                                    <td>@bed.Edd</td>
                                    <td>@bed.WaitingFor</td>

                                    <td>
                                        <div class="bm-inline-actions">
                                            @foreach (var action in V2ActionDefs)
                                            {
                                                <button type="button" title="@action.Label" @onclick="() => ApplyBedAction(bed, action.Key)">
                                                    <MudIcon Icon="@action.Icon" Size="Size.Small" />
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            </section>

            <aside class="bm-right-panel">
                <article>
                    <h4>Incoming</h4>

                    <div class="bm-allocation-tabs">
                        @foreach (var tab in V2IncomingTabs)
                        {
                            <button type="button" class="@(V2IncomingTab == tab ? "active" : null)" @onclick="() => V2IncomingTab = tab">
                                @tab (@V2IncomingByTab[tab].Count)
                            </button>
                        }
                    </div>

                    <div class="bm-cards bm-cards-compact">
                        @foreach (var card in V2IncomingByTab[V2IncomingTab].Take(4))
                        {
                            <article class="bm-patient-card bm-patient-card-compact" draggable="true" @ondragstart="() => StartDragFromIncoming(card)">
                                <div class="bm-patient-row-top">
                                    <strong>@card.Code · @card.Meta</strong>
                                    <span class="bm-priority">@card.Priority</span>
                                </div>
                                <p class="bm-patient-name">@card.Name</p>
                                <p class="bm-patient-reason">@card.Reason</p>
                            </article>
                        }
                    </div>
                </article>

                <article>
                    <h4>Quick Actions</h4>

                    <div class="bm-actions">
                        @foreach (var action in V2ActionDefs)
                        {
                            <button type="button"
                                    class="qa-drop @(_hoverAction == action.Key ? "hover" : null)"
                                    @ondragover="() => HoverAction(action.Key)"
                                    @ondragover:preventDefault="true"
                                    @ondragleave="() => _hoverAction = null"
                                    @ondrop="() => DropBedToAction(action.Key)">
                                <MudIcon Icon="@action.Icon" Size="Size.Small" />
                                @action.Label
                            </button>
                        }
                    </div>
                </article>

                <article>
                    <h4>Drop Zones</h4>

                    <div class="bm-targets">
                        @foreach (var target in V2MoveTargets)
                        {
                            <div class="bm-move-target"
                                 @ondragover="AllowDrop"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => DropBedToTarget(target)">
                                @target
                            </div>
                        }
                    </div>
                </article>

                <article>
                    <h4>Recent Activity</h4>

                    <ul class="bm-activity">
                        @foreach (var item in V2Activity.Take(4))
                        {
                            <li>@item</li>
                        }
                    </ul>
                </article>
            </aside>
        </div>
    }
</section>

@code {
    private string WardVersion { get; set; } = "V1";
    private string IncomingTab { get; set; } = "ED";
    private string V2IncomingTab { get; set; } = "ED";
    private string? OpenWardKpiInfo { get; set; }

    private string? _hoverAction;
    private string _dragMode = string.Empty;
    private IncomingCard? _draggedIncoming;
    private BedRow? _draggedBed;

    private static readonly string[] IncomingTabs = { "ED", "Elective", "IHT", "Add On", "Ward Transfer" };
    private static readonly string[] V2IncomingTabs = { "ED", "IHT", "OPD", "Other" };

    private readonly Dictionary<string, List<IncomingCard>> IncomingByTab = new()
    {
        ["ED"] = new(),
        ["Elective"] = new(),
        ["IHT"] = new(),
        ["Add On"] = new(),
        ["Ward Transfer"] = new()
    };

    private IEnumerable<(string Source, int Count, string Note)> IncomingPressure => new[]
    {
        ("ED", IncomingByTab["ED"].Count, "Source location pending"),
        ("Elective", IncomingByTab["Elective"].Count, "Booked admissions today"),
        ("IHT", IncomingByTab["IHT"].Count, "Inter-hospital transfers"),
        ("Add-on", IncomingByTab["Add On"].Count, "Post procedure / OPD"),
        ("Ward transfer", IncomingByTab["Ward Transfer"].Count, "Internal ward moves")
    };

    private readonly Dictionary<string, List<IncomingCard>> V2IncomingByTab = new()
    {
        ["ED"] = new(),
        ["IHT"] = new(),
        ["OPD"] = new(),
        ["Other"] = new()
    };

    private readonly List<string> V2MoveTargets = new()
    {
        "IHT Returns Queue",
        "Pending Transfer",
        "Temporary Hold",
        "Discharge Pending"
    };

    private readonly List<string> V2Activity = new()
    {
        "12:20 Bed 3 marked Cleaning",
        "12:25 Bed 3 marked Ready",
        "12:26 Bed 4 blocked due to adjacent behaviour risk",
        "12:27 Maintenance requested for Bed 8"
    };

    private readonly (string Key, string Label, string Icon)[] V2ActionDefs =
    {
        ("ready", "Mark Ready", Icons.Material.Outlined.CheckCircle),
        ("cleaning", "Mark Cleaning", Icons.Material.Outlined.CleaningServices),
        ("block", "Block Bed", Icons.Material.Outlined.Lock),
        ("maintenance", "Request Maintenance", Icons.Material.Outlined.Handyman),
        ("isolation", "Mark As Isolation", Icons.Material.Outlined.Shield),
        ("note", "Add Operational Note", Icons.Material.Outlined.StickyNote2)
    };

    private List<BedRow> BedRows = new();
    private List<BedRow> V2BedRows = new();
    private static readonly IReadOnlyList<SituationalKpiTile.KpiBreakdownItem> WardPendingBreakdown = new[]
    {
        new SituationalKpiTile.KpiBreakdownItem("Cleaning", "2"),
        new SituationalKpiTile.KpiBreakdownItem("Maintenance", "2"),
        new SituationalKpiTile.KpiBreakdownItem("Closed", "3"),
        new SituationalKpiTile.KpiBreakdownItem("Planned", "1")
    };

    private void ToggleWardKpiInfo(string title) => OpenWardKpiInfo = OpenWardKpiInfo == title ? null : title;
    private void CloseKpiInfo() => OpenWardKpiInfo = null;

    protected override void OnInitialized()
    {
        BedRows = Enumerable.Range(1, 24).Select(CreateBed).ToList();

        IncomingByTab["ED"] = new()
        {
            new IncomingCard("ED001", "DEMO-PAT-ED-01", "Source location pending", "ED", "Future bed: Bed 12", "Bed 12"),
            new IncomingCard("ED002", "DEMO-PAT-ED-02", "Awaiting ward bed", "ED", "Future bed: Unallocated", ""),
            new IncomingCard("ED003", "DEMO-PAT-ED-03", "Admission review pending", "ED", "Future bed: Unallocated", "")
        };

        IncomingByTab["Elective"] = new()
        {
            new IncomingCard("ELEC001", "DEMO-PAT-ELEC-01", "Planned admission", "Elective", "Future bed: Unallocated", "")
        };

        IncomingByTab["IHT"] = new()
        {
            new IncomingCard("IHT001", "DEMO-PAT-IHT-01", "Inter-hospital transfer", "IHT", "Future bed: Unallocated", "")
        };

        IncomingByTab["Add On"] = new()
        {
            new IncomingCard("ADD001", "DEMO-PAT-ADD-01", "Post procedure add-on", "Add On", "Future bed: Unallocated", "")
        };

        IncomingByTab["Ward Transfer"] = new()
        {
            new IncomingCard("WTR001", "DEMO-PAT-WTR-01", "Ward transfer requested", "Ward Transfer", "Future bed: Unallocated", "")
        };

        ReconcileFutureAllocations();

        var feed = QHPFH_ConceptPrototype.Data.DemoHubData.BuildPatientAdmissions();
        V2BedRows = Enumerable.Range(1, 48).Select(n => CreateV2Bed(n, feed)).ToList();

        V2IncomingByTab["ED"] = feed.Take(4)
            .Select((p, i) => new IncomingCard(
                $"ED{i + 1:000}",
                $"{p.LastName.ToUpperInvariant()}, {p.FirstName}",
                "Emergency admission",
                "ED",
                $"{DateTime.Now.AddMinutes(20 + i * 10):HH:mm}",
                i == 0 ? "High" : "Medium"))
            .ToList();

        V2IncomingByTab["IHT"] = feed.Skip(20).Take(2)
            .Select((p, i) => new IncomingCard(
                $"IHT{i + 1:000}",
                $"{p.LastName.ToUpperInvariant()}, {p.FirstName}",
                "Inter-hospital transfer",
                "IHT",
                $"{DateTime.Now.AddMinutes(35 + i * 10):HH:mm}",
                "Medium"))
            .ToList();

        V2IncomingByTab["OPD"] = feed.Skip(40).Take(1)
            .Select((p, i) => new IncomingCard(
                $"OPD{i + 1:000}",
                $"{p.LastName.ToUpperInvariant()}, {p.FirstName}",
                "Post procedure",
                "OPD",
                $"{DateTime.Now.AddMinutes(55):HH:mm}",
                "Low"))
            .ToList();
    }

    private void UpdateFutureBed(IncomingCard card, string? value)
    {
        card.FutureBed = value ?? string.Empty;
        card.FutureBedLabel = string.IsNullOrWhiteSpace(card.FutureBed)
            ? "Future bed: Unallocated"
            : $"Future bed: {card.FutureBed}";

        ReconcileFutureAllocations();
    }

    private void ReconcileFutureAllocations()
    {
        foreach (var bed in BedRows)
        {
            bed.FutureAllocation = string.Empty;
        }

        foreach (var incoming in IncomingByTab.SelectMany(x => x.Value).Where(x => !string.IsNullOrWhiteSpace(x.FutureBed)))
        {
            var bed = BedRows.FirstOrDefault(b => b.BedLabel == incoming.FutureBed);

            if (bed is not null)
            {
                bed.FutureAllocation = $"{incoming.Source} patient arriving";
            }
        }
    }

    private static BedRow CreateBed(int n)
    {
        if (n == 8)
        {
            return new("Bed 8", "Open / Ready", string.Empty, string.Empty, "General Surgery", "—", "Ward", "—", 0, "—", "—", 0, "Available", bedType: "Standard");
        }

        if (n == 9)
        {
            return new("Bed 9", "Cleaning", string.Empty, string.Empty, "General Surgery", "—", "Ward", "—", 0, "Cleaning requested", "—", 0, "Awaiting cleaning", bedType: "Standard");
        }

        if (n == 10)
        {
            return new("Bed 10", "Maintenance", string.Empty, string.Empty, "General Surgery", "—", "Ward", "—", 0, "Engineering requested", "—", 0, "Closed for maintenance", bedType: "Bariatric");
        }

        if (n == 11)
        {
            return new("Bed 11", "Closed", string.Empty, string.Empty, "General Surgery", "—", "Ward", "—", 0, "—", "—", 0, "Operational closure", bedType: "Paediatric");
        }

        if (n == 12)
        {
            var planned = new BedRow("Bed 12", "Pending", string.Empty, string.Empty, "General Surgery", "—", "ED", "TBC", 0, "Admission review", "—", 0, "Source location pending", bedType: "Specialist");
            planned.FutureAllocation = "Planned patient from ED";
            return planned;
        }

        if (n == 20)
        {
            return new("Bed 20", "Open / Ready", string.Empty, string.Empty, "General Surgery", "—", "Ward", "—", 0, "—", "—", 0, "Available", bedType: "Standard");
        }

        if (n == 21)
        {
            return new("Bed 21", "Cleaning", string.Empty, string.Empty, "General Surgery", "—", "Ward", "—", 0, "Cleaning requested", "—", 0, "Awaiting cleaning", bedType: "Isolation");
        }

        if (n == 22)
        {
            return new("Bed 22", "Maintenance", string.Empty, string.Empty, "General Surgery", "—", "Ward", "—", 0, "Engineering requested", "—", 0, "Closed for maintenance", bedType: "Telemetry");
        }

        if (n == 23 || n == 24)
        {
            return new($"Bed {n}", "Closed", string.Empty, string.Empty, "General Surgery", "—", "Ward", "—", 0, "—", "—", 0, "Operational closure", bedType: n == 23 ? "Standard" : "Specialist");
        }

        var ews = (n % 5) + 1;

        var fictionalNames = new[]
        {
            "Clark Kent","Diana Prince","Bruce Wayne","Peter Parker","Natasha Romanoff","Tony Stark","Leia Organa","Ellen Ripley",
            "Sarah Connor","Marty McFly","Wanda Maximoff","Jean Grey","Hermione Granger","Indiana Jones","Dana Scully","Neo Anderson",
            "Katniss Everdeen","Bruce Banner","Selina Kyle","Luke Skywalker","Arthur Curry","Logan Howlett","Barry Allen","Padme Amidala"
        };
        var patientName = fictionalNames[(n - 1) % fictionalNames.Length];
        var bedType = n switch
        {
            3 => "Isolation",
            6 => "Telemetry",
            15 => "Bariatric",
            18 => "Specialist",
            _ => "Standard"
        };

        return new(
            $"Bed {n}",
            "Occupied",
            patientName,
            $"MRN DEMO{n:000} | {(30 + n % 35)}y | {(n % 2 == 0 ? "F" : "M")}",
            n % 3 == 0 ? "General Medicine" : "General Surgery",
            n % 4 == 0 ? "Penicillin" : "NKA",
            n % 3 == 0 ? "IHT" : "ED",
            "26 May",
            20 + (n * 3 % 75),
            n % 5 == 0 ? "Imaging pending" : "Bloods pending",
            n % 2 == 0 ? "Diabetic" : "Regular",
            ews,
            n % 5 == 0 ? "Waiting for what: imaging" : "Clinical review",
            losDays: 1 + (n % 9),
            bedType: bedType);
    }

    private static void AllowDrop(DragEventArgs _)
    {
    }

    private void HoverAction(string key)
    {
        _hoverAction = key;
    }

    private void StartDragFromIncoming(IncomingCard card)
    {
        _dragMode = "incoming";
        _draggedIncoming = card;
        _draggedBed = null;
    }

    private void StartDragBedForAction(BedRow bed)
    {
        _dragMode = "bed";
        _draggedBed = bed;
        _draggedIncoming = null;
    }

    private void DropPatientToBed(BedRow bed)
    {
        if (_dragMode != "incoming" || _draggedIncoming is null)
        {
            return;
        }

        if (bed.Status != "Open / Ready")
        {
            return;
        }

        bed.Assign(_draggedIncoming);

        foreach (var list in V2IncomingByTab.Values)
        {
            list.Remove(_draggedIncoming);
        }

        V2Activity.Insert(0, $"{DateTime.Now:HH:mm} {_draggedIncoming.Code} assigned to {bed.BedLabel}");

        _draggedIncoming = null;
        _dragMode = string.Empty;
    }

    private void DropBedToAction(string key)
    {
        if (_dragMode != "bed" || _draggedBed is null)
        {
            return;
        }

        ApplyBedAction(_draggedBed, key);

        _draggedBed = null;
        _dragMode = string.Empty;
        _hoverAction = null;
    }

    private void DropBedToTarget(string target)
    {
        if (_draggedBed is null || !_draggedBed.HasPatient)
        {
            return;
        }

        V2IncomingByTab["IHT"].Add(new IncomingCard(
            "IHT-R",
            _draggedBed.PatientName,
            _draggedBed.Team,
            "From ward",
            target,
            "Medium"));

        V2Activity.Insert(0, $"{DateTime.Now:HH:mm} {_draggedBed.BedLabel} moved to {target}");

        _draggedBed.MarkCleaning();

        _draggedBed = null;
        _dragMode = string.Empty;
    }

    private void ApplyBedAction(BedRow bed, string key)
    {
        switch (key)
        {
            case "ready":
                bed.Status = "Open / Ready";
                bed.WaitingFor = "Available";
                if (!bed.HasPatient)
                {
                    bed.ClearPatient();
                }
                V2Activity.Insert(0, $"{DateTime.Now:HH:mm} {bed.BedLabel} marked Ready");
                break;

            case "cleaning":
                bed.MarkCleaning();
                V2Activity.Insert(0, $"{DateTime.Now:HH:mm} {bed.BedLabel} marked Cleaning");
                break;

            case "block":
                bed.Status = "Blocked";
                bed.WaitingFor = "NUM hold";
                V2Activity.Insert(0, $"{DateTime.Now:HH:mm} {bed.BedLabel} blocked");
                break;

            case "maintenance":
                bed.Status = "Maintenance";
                bed.WaitingFor = "Maintenance review";
                V2Activity.Insert(0, $"{DateTime.Now:HH:mm} Maintenance requested for {bed.BedLabel}");
                break;

            case "isolation":
                bed.Status = "Isolation / Specialist";
                bed.WaitingFor = "Isolation review";
                V2Activity.Insert(0, $"{DateTime.Now:HH:mm} {bed.BedLabel} marked Isolation / Specialist");
                break;

            case "note":
                V2Activity.Insert(0, $"{DateTime.Now:HH:mm} Operational note added for {bed.BedLabel}");
                break;
        }
    }

    private static BedRow CreateV2Bed(int n, IReadOnlyList<QHPFH_ConceptPrototype.Models.PatientAdmission> feed)
    {
        if (n == 8)
        {
            return new($"Bed {n}", "Maintenance", string.Empty, string.Empty, "-", "-", "Ward", "-", 0, "-", "-", 0, "Maintenance review");
        }

        if (n == 9)
        {
            return new($"Bed {n}", "Blocked", string.Empty, string.Empty, "-", "-", "Ward", "-", 0, "-", "-", 0, "NUM hold");
        }

        var status = n % 7 == 0 ? "Open / Ready" : n % 6 == 0 ? "Cleaning" : "Occupied";
        var patient = feed[(n * 3) % feed.Count];
        var patientName = status == "Occupied" ? $"{patient.LastName.ToUpperInvariant()}, {patient.FirstName}" : string.Empty;
        var demographics = status == "Occupied" ? $"MRN DEMO{n:000} | {patient.Age}y | {patient.Sex}" : string.Empty;

        return new(
            $"Bed {n}",
            status,
            patientName,
            demographics,
            "General Surgery",
            status == "Occupied" ? "None" : "-",
            "ED",
            "26 May",
            status == "Occupied" ? 30 : 0,
            status == "Occupied" ? "Results pending" : "-",
            "Regular",
            status == "Occupied" ? 2 : 0,
            status == "Open / Ready" ? "Available" : status == "Cleaning" ? "Awaiting cleaning" : "Clinical review");
    }

    private static string StatusIcon(string status)
    {
        return status switch
        {
            "Occupied" => Icons.Material.Outlined.Person,
            "Open / Ready" => Icons.Material.Outlined.CheckCircle,
            "Cleaning" => Icons.Material.Outlined.CleaningServices,
            "Closed" => Icons.Material.Outlined.Lock,
            "Pending" => Icons.Material.Outlined.PendingActions,
            "Queued / planned" => Icons.Material.Outlined.EventAvailable,
            "Blocked" => Icons.Material.Outlined.Lock,
            "Maintenance" => Icons.Material.Outlined.Handyman,
            "Isolation / Specialist" => Icons.Material.Outlined.Shield,
            _ => Icons.Material.Outlined.Bed
        };
    }

    private sealed class IncomingCard
    {
        public IncomingCard(string code, string name, string status, string source, string meta, string priority)
        {
            Code = code;
            Name = name;
            Status = status;
            Source = source;
            FutureBedLabel = meta;
            FutureBed = meta.StartsWith("Bed ", StringComparison.OrdinalIgnoreCase) ? meta : string.Empty;
            Meta = meta;
            Priority = priority;
            Reason = status;
        }

        public string Code { get; }
        public string Name { get; }
        public string Status { get; }
        public string Source { get; }
        public string Reason { get; }
        public string FutureBedLabel { get; set; }
        public string FutureBed { get; set; }
        public string Meta { get; set; }
        public string Priority { get; set; }
    }

    private sealed class BedRow
    {
        public BedRow(
            string bedLabel,
            string status,
            string patientName,
            string demographics,
            string team,
            string allergies,
            string referral,
            string edd,
            int dischargeProgress,
            string requests,
            string diet,
            int ews,
            string waitingFor,
            int losDays = 0,
            string bedType = "Standard")
        {
            BedLabel = bedLabel;
            Status = status;
            PatientName = patientName;
            Demographics = demographics;
            Team = team;
            Allergies = allergies;
            Referral = referral;
            Edd = edd;
            DischargeProgress = dischargeProgress;
            Requests = requests;
            Diet = diet;
            Ews = ews;
            WaitingFor = waitingFor;
            LosDays = losDays;
            BedType = bedType;
        }

        public string BedLabel { get; }
        public string Status { get; set; }
        public string PatientName { get; set; }
        public string Demographics { get; set; }
        public string Team { get; set; }
        public string Allergies { get; set; }
        public string Referral { get; set; }
        public string Edd { get; set; }
        public int DischargeProgress { get; set; }
        public string Requests { get; set; }
        public string Diet { get; set; }
        public int Ews { get; set; }
        public string WaitingFor { get; set; }
        public int LosDays { get; set; }
        public string BedType { get; set; }
        public string FutureAllocation { get; set; } = string.Empty;

        public bool HasPatient => !string.IsNullOrWhiteSpace(PatientName);

        public string PatientStateLabel => HasPatient
            ? "Actual inpatient · on ward"
            : !string.IsNullOrWhiteSpace(FutureAllocation)
                ? "Planned admission · source location pending"
                : "No patient allocated";

        public string PlacementStatus => HasPatient
            ? "On ward"
            : !string.IsNullOrWhiteSpace(FutureAllocation)
                ? "Allocated · source location pending"
                : Status;

        public string StatusClass => Status
            .ToLowerInvariant()
            .Replace(" / ", "-")
            .Replace(" ", "-");

        public void Assign(IncomingCard card)
        {
            Status = "Occupied";
            PatientName = card.Name;
            Demographics = $"MRN {card.Code} | incoming";
            Referral = card.Source;
            Edd = "TBC";
            Requests = card.Reason;
            Diet = "Regular";
            Ews = 1;
            WaitingFor = "Admission review";
            DischargeProgress = 0;
            LosDays = 0;
            FutureAllocation = string.Empty;
        }

        public void MarkCleaning()
        {
            Status = "Cleaning";
            ClearPatient();
            WaitingFor = "Awaiting cleaning";
            Requests = "Housekeeping";
            Referral = "Ward";
        }

        public void ClearPatient()
        {
            PatientName = string.Empty;
            Demographics = string.Empty;
            Allergies = "—";
            Referral = "Ward";
            Edd = "—";
            DischargeProgress = 0;
            Requests = "—";
            Diet = "—";
            Ews = 0;
            LosDays = 0;
            FutureAllocation = string.Empty;
        }
    }
}
