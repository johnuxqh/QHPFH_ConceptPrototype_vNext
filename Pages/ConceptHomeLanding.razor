@using QHPFH_ConceptPrototype.Models
@using QHPFH_ConceptPrototype.Services
@using QHPFH_ConceptPrototype.Services.Adaptive
@using QHPFH_ConceptPrototype.Services.Context
@inject PrototypeExperienceStateService ExperienceState
@inject AdaptivePerspectiveEngine AdaptivePerspective
@inject ContextAwarenessService ContextAwareness
@inject NavigationManager Navigation
@implements IDisposable

<section class="concept-home-launchpad my-hub-landing">
    <header class="my-hub-hero">
        <div>
            <p class="my-hub-eyebrow">My Hub</p>
            <h1>@CurrentPlan.Title</h1>
            <p>@CurrentPlan.Description</p>
        </div>
        <div class="my-hub-context-card" aria-label="Current operational context">
            <span>Current role</span>
            <strong>@ExperienceState.Current.RoleLabel</strong>
            <span>Scope</span>
            <strong>@ExperienceState.Current.ScopeLabel</strong>
            <span>Context</span>
            <strong>@ContextAwareness.GetCurrentLocation().SummaryText</strong>
        </div>
    </header>

    <section class="my-hub-start-card" aria-label="Recommended starting workspace">
        <div>
            <span class="my-hub-recommendation-label">Recommended start</span>
            <h2>@CurrentPlan.StartWorkspace</h2>
            <p>@CurrentPlan.StartReason</p>
        </div>
        <button type="button" class="bm-primary" @onclick="() => NavigateTo(CurrentPlan.StartRoute)">Open @CurrentPlan.StartWorkspace</button>
    </section>

    <section class="my-hub-grid" aria-label="Role based workspace links">
        <article class="my-hub-panel">
            <div class="my-hub-panel-heading">
                <p>Relevant workspaces</p>
                <h3>Where to work next</h3>
            </div>
            <div class="my-hub-quick-links">
                @foreach (var link in CurrentPlan.QuickLinks)
                {
                    <button type="button" class="@(link.Route == CurrentPlan.StartRoute ? "recommended" : string.Empty)" disabled="@string.IsNullOrWhiteSpace(link.Route)" @onclick="() => NavigateTo(link.Route)">
                        <span>@link.Label</span>
                        <small>@link.Description</small>
                    </button>
                }
            </div>
        </article>

        <article class="my-hub-panel">
            <div class="my-hub-panel-heading">
                <p>Role focus</p>
                <h3>Today’s priorities</h3>
            </div>
            <ul class="my-hub-priority-list">
                @foreach (var priority in CurrentPlan.Priorities)
                {
                    <li>@priority</li>
                }
            </ul>
        </article>
    </section>
</section>

@code {
    private UserPerspectiveType CurrentPerspectiveType => AdaptivePerspective.GetCurrentPerspective()?.PerspectiveType ?? UserPerspectiveType.Executive;
    private RoleLandingPlan CurrentPlan => GetPlan(CurrentPerspectiveType);

    protected override void OnInitialized()
    {
        ExperienceState.OnChange += HandleContextChanged;
        ContextAwareness.OnContextChanged += HandleContextChanged;
        AdaptivePerspective.OnChange += HandleContextChanged;
    }

    private void NavigateTo(string route)
    {
        if (!string.IsNullOrWhiteSpace(route))
        {
            Navigation.NavigateTo(route);
        }
    }

    private void HandleContextChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ExperienceState.OnChange -= HandleContextChanged;
        ContextAwareness.OnContextChanged -= HandleContextChanged;
        AdaptivePerspective.OnChange -= HandleContextChanged;
    }

    private static RoleLandingPlan GetPlan(UserPerspectiveType perspectiveType) => perspectiveType switch
    {
        UserPerspectiveType.HHSCoordinator => new(
            "HHS coordination start point",
            "Review HHS capacity, facility comparison, escalation and demand coordination.",
            "Bed Management",
            "Start with HHS-level capacity and facility pressure before coordinating demand actions.",
            "bed-management",
            [
                new("Bed Management", "bed-management", "HHS capacity and facility pressure"),
                new("Allocation Centre", "allocation-centre", "Placement demand and movement pressure"),
                new("Delayed Discharge", "", "Exit barriers and delayed flow"),
                new("Scenario Mapping", "", "Demand and capacity planning")
            ],
            [
                "Review HHS-level bed capacity and facility pressure.",
                "Check escalation signals and demand/capacity mismatch.",
                "Coordinate placement and delayed-flow actions across facilities."
            ]),
        UserPerspectiveType.BedManager or UserPerspectiveType.FacilityCoordinator or UserPerspectiveType.OperationsCentre => new(
            "Facility flow start point",
            "Focus on facility capacity, ward pressure, allocation demand and escalation coordination.",
            "Bed Management",
            "Start with facility capacity and ward pressure, then move to placement decisions.",
            "bed-management",
            [
                new("Bed Management", "bed-management", "Facility capacity and ward pressure"),
                new("Allocation Centre", "allocation-centre", "Patient placement and queued demand"),
                new("Ward View", "ward-operations", "Ward-level bed status and handover"),
                new("Delayed Discharge", "", "Discharge blockers and exit opportunities")
            ],
            [
                "Review open, occupied and pending beds by ward.",
                "Open Allocation Centre for ED, elective, IHT and transfer demand.",
                "Escalate wards under pressure and confirm flow actions."
            ]),
        UserPerspectiveType.WardClinician or UserPerspectiveType.NUM => new(
            "Ward operations start point",
            "Focus on bed status, incoming admissions, handover readiness and support actions.",
            "Ward View",
            "Start with ward bed status, current patients, expected arrivals and handover needs.",
            "ward-operations",
            [
                new("Ward View", "ward-operations", "Bed status, admissions and handover"),
                new("Allocation Centre", "allocation-centre", "Incoming demand and planned allocations"),
                new("Bed Management", "bed-management", "Facility and ward pressure context"),
                new("Patient Journey", "", "Clinical movement and care pathway context")
            ],
            [
                "Review bed status, cleaning, closure and maintenance states.",
                "Check incoming admissions and source-location pending patients.",
                "Generate handover, contact bed manager and prepare support actions."
            ]),
        _ => new(
            "State flow coordination start point",
            "Review statewide capacity, HHS/facility pressure, escalation and bed management overview.",
            "Bed Management",
            "Start with statewide capacity and pressure before drilling into HHS and facility views.",
            "bed-management",
            [
                new("Bed Management", "bed-management", "Statewide capacity and pressure overview"),
                new("Allocation Centre", "allocation-centre", "Placement pressure and queued demand"),
                new("Scenario Mapping", "", "Statewide demand and capacity planning"),
                new("Delayed Discharge", "", "System exit barriers")
            ],
            [
                "Review statewide bed capacity and HHS/facility pressure.",
                "Identify escalation points and demand hot spots.",
                "Coordinate flow actions across bed management and placement workspaces."
            ])
    };

    private sealed record RoleLandingPlan(
        string Title,
        string Description,
        string StartWorkspace,
        string StartReason,
        string StartRoute,
        IReadOnlyList<HubQuickLink> QuickLinks,
        IReadOnlyList<string> Priorities);

    private sealed record HubQuickLink(string Label, string Route, string Description);
}
